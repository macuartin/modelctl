#!/usr/bin/env python3
"""Manage the local llama.cpp router on :8080.

Replaces ia-stack, which also drove ComfyUI. ComfyUI is gone from this machine,
so this only handles the text router: what is loaded, what fits, load, unload.

The router is the single source of truth. Model config (load-on-startup,
embeddings, reranking) is read from status.preset, which is the .ini text the
router parsed; the live context size comes from status.args, because the preset
can drift from the running process.
"""

import argparse
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

ROUTER = os.environ.get("LLAMA_ROUTER", "http://127.0.0.1:8080")
ENV_FILE = Path(os.environ.get("LLAMA_ENV_FILE") or
                (Path.home() / ".config" / "llama-server.env"))

# Loading the titular after a reboot takes minutes; unloading is quick.
LOAD_TIMEOUT = 300
UNLOAD_TIMEOUT = 60

SCHEMA_VERSION = 1

# A model with any of these in its preset is protected from unload: andino-kb
# needs the embedding and reranker, and the startup set is what agents expect
# to find loaded.
PROTECTED_KEYS = {
    "load-on-startup": "load-on-startup",
    "embeddings": "embeddings",
    "reranking": "reranking",
}


def api_key():
    """Key from the env file, accepting both formats in the wild.

    An env file carries API_KEY=...; the file llama-server's own
    --api-key-file reads carries bare keys, one per line. Pointing this tool
    and the server at the same file should just work, so accept either.
    """
    try:
        bare = ""
        for line in ENV_FILE.read_text().splitlines():
            line = line.strip()
            if line.startswith("API_KEY="):
                return line.split("=", 1)[1].strip()
            if not bare and line and not line.startswith("#") and "=" not in line:
                bare = line
        if bare:
            return bare
    except OSError:
        pass
    return os.environ.get("LLAMA_API_KEY", "")


class RefuseRedirect(urllib.request.HTTPRedirectHandler):
    """The router API never redirects, so any 3xx fails loudly instead.

    urllib's default handler replays regular headers, Authorization included,
    against whatever host the redirect names, which would hand the API key to
    a compromised or hostile router (marketplace review, omarchy issue 2334).
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


OPENER = urllib.request.build_opener(RefuseRedirect)


def authorized_request(url, **kwargs):
    req = urllib.request.Request(url, **kwargs)
    # Unredirected as belt and braces: even a future opener that follows
    # redirects again would drop this header on the way.
    req.add_unredirected_header("Authorization", f"Bearer {api_key()}")
    return req


def request_json(path, payload=None, timeout=5):
    data = json.dumps(payload).encode() if payload is not None else None
    req = authorized_request(f"{ROUTER}{path}", data=data,
                             method="POST" if data else "GET")
    if data:
        req.add_header("Content-Type", "application/json")
    with OPENER.open(req, timeout=timeout) as resp:
        body = resp.read().decode()
    return json.loads(body) if body else {}


def memory_mib():
    """Used and total MiB of the pool the models live in, plus its label.

    GTT is where an AMD APU keeps them; a discrete card reports VRAM instead.
    Neither exists on plain NVIDIA, and the caller renders nothing rather than
    lying with zeroes.
    """
    for pool in ("gtt", "vram"):
        for dev in sorted(Path("/sys/class/drm").glob("card*/device")):
            total = dev / f"mem_info_{pool}_total"
            used = dev / f"mem_info_{pool}_used"
            if not total.is_file():
                continue
            try:
                return (
                    int(used.read_text()) // 1024 // 1024,
                    int(total.read_text()) // 1024 // 1024,
                    pool.upper(),
                )
            except (OSError, ValueError):
                continue
    return 0, 0, ""


def find_router_proc():
    """argv of the running router, or None when it is not up.

    One pass over /proc serves every caller that wants a piece of the command
    line (sources, --models-max); three separate scans read every PID three
    times for the same bytes.
    """
    candidates = []
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            argv = (proc / "cmdline").read_bytes().decode().split("\0")
        except OSError:
            continue
        if any("llama-server" in a for a in argv):
            candidates.append(argv)
    # The text router is the one with model discovery flags; a bare
    # llama-server (single-model mode) still counts if nothing better exists.
    for argv in candidates:
        if "--models-preset" in argv or "--models-dir" in argv:
            return argv
    return candidates[0] if candidates else None


def model_sources(proc):
    """Where the router discovers models: the preset file, a directory, or both.

    Read from the live process rather than configured here, so the panel points
    at whatever this machine actually runs.
    """
    out = {"presetFile": "", "modelsDir": ""}
    for flag, key in (("--models-preset", "presetFile"), ("--models-dir", "modelsDir")):
        if flag in proc:
            idx = proc.index(flag)
            if idx + 1 < len(proc):
                out[key] = proc[idx + 1]
    return out


def models_max(proc):
    """--models-max the router actually runs with, or 0 when it cannot be read.

    0 means unknown here, not unlimited. llama.cpp documents 0 as unlimited but
    refuses to start with it when any model is load-on-startup ("number of
    models to load on startup (4) exceeds models_max (0)"), so nothing should
    treat 0 as a real cap either way. Returning a plausible default instead
    would have the panel state a limit nobody set.
    """
    if "--models-max" in proc:
        idx = proc.index("--models-max")
        if idx + 1 < len(proc):
            try:
                return int(proc[idx + 1])
            except ValueError:
                pass
    return 0


def parse_preset(text):
    """The preset is .ini text; pull out the boolean keys we care about."""
    keys = {}
    for raw in (text or "").splitlines():
        line = raw.split(";", 1)[0].strip()
        if not line or line.startswith("[") or "=" not in line:
            continue
        k, v = (x.strip() for x in line.split("=", 1))
        keys[k] = v
    return keys


def arg_value(args, flag):
    if not isinstance(args, list):
        return None
    if flag in args:
        idx = args.index(flag)
        if idx + 1 < len(args):
            return args[idx + 1]
    return None


def fetch_models():
    """Normalized model list, or None when the router does not answer."""
    try:
        data = request_json("/v1/models")
    except (urllib.error.URLError, OSError, ValueError, json.JSONDecodeError):
        return None

    out = []
    for entry in data.get("data", []):
        status = entry.get("status") or {}
        preset = parse_preset(status.get("preset"))

        # A failed model reports value "unloaded" like a healthy one. Keeping
        # them apart is the whole point: on 2026-08-24 three models sat failed
        # for hours looking merely idle.
        state = str(status.get("value") or "unknown")
        if status.get("failed"):
            state = "failed"

        reasons = [label for key, label in PROTECTED_KEYS.items()
                   if preset.get(key, "").lower() == "true"]

        ctx = arg_value(status.get("args"), "--ctx-size") or preset.get("c") or preset.get("ctx-size")
        try:
            ctx = int(ctx)
        except (TypeError, ValueError):
            ctx = None

        out.append({
            "id": entry.get("id"),
            "state": state,
            "protected": bool(reasons),
            "protectedReason": reasons[0] if reasons else None,
            "exitCode": status.get("exit_code"),
            "contextSize": ctx,
            "progress": None,
            "stage": None,
        })
    # Failed first, then whatever is in flight: the panel scrolls and a
    # failure buried at the bottom of twelve rows is invisible, which is the
    # exact situation this widget exists to prevent.
    STATE_RANK = {"failed": 0, "loading": 1, "unloading": 1,
                  "loaded": 2, "sleeping": 3}
    out.sort(key=lambda m: (STATE_RANK.get(m["state"], 4), m["id"] or ""))
    return out


def build_status():
    used, total, pool = memory_mib()
    models = fetch_models()
    reachable = models is not None
    models = models or []
    proc = find_router_proc() or []
    return {
        "schemaVersion": SCHEMA_VERSION,
        "updatedAt": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "router": {
            "reachable": reachable,
            "url": ROUTER,
            "modelsMax": models_max(proc),
            "sources": model_sources(proc),
            "loadedCount": sum(1 for m in models if m["state"] == "loaded"),
        },
        "memory": {
            "pool": pool,
            "usedMiB": used,
            "totalMiB": total,
            "percent": round(used * 100 / total) if total else 0,
        },
        "models": models,
    }


MARK = {"loaded": "●", "failed": "⚠", "loading": "◐"}


def render(status):
    mem = status["memory"]
    if mem["totalMiB"]:
        free_gib = (mem["totalMiB"] - mem["usedMiB"]) // 1024
        print("{:<8} {:.1f} / {:.1f} GiB  ({}%)   free: ~{} GiB".format(
            mem["pool"], mem["usedMiB"] / 1024, mem["totalMiB"] / 1024,
            mem["percent"], free_gib))

    router = status["router"]
    if not router["reachable"]:
        parts = urllib.parse.urlsplit(router["url"])
        where = f":{parts.port}" if parts.hostname in ("127.0.0.1", "localhost") else parts.netloc
        print(f"Router   {where}  ⚠ not responding")
        return

    parts = urllib.parse.urlsplit(router["url"])
    where = f":{parts.port}" if parts.hostname in ("127.0.0.1", "localhost") else parts.netloc
    head = f"Router   {where}  ".ljust(16)
    pad = " " * len(head)
    if not status["models"]:
        print(head + "no models registered")
    for i, m in enumerate(status["models"]):
        prefix = head if i == 0 else pad
        mark = MARK.get(m["state"], "○")
        line = f"{prefix}{mark} {m['id']}"
        if m["state"] == "failed":
            line += f" (FAILED, exit {m['exitCode']})"
        elif m["state"] != "loaded":
            line += " (unloaded)"
        if m["protected"]:
            line += f"  [{m['protectedReason']}]"
        print(line)

    if router["modelsMax"] > 0:
        print(f"\n{router['loadedCount']} of {router['modelsMax']} slots in use")
    else:
        print(f"\n{router['loadedCount']} models loaded (slot cap unknown)")
    failed = [m for m in status["models"] if m["state"] == "failed"]
    if failed:
        print("\n⚠ Failed to load: " + ", ".join(m["id"] for m in failed))
        # restore only touches the startup set, so pointing anyone else at it
        # sends them to a command that will ignore their model.
        startup = [m["id"] for m in failed if m["protectedReason"] == "load-on-startup"]
        if startup:
            print("  Retry with: modelctl restore")
        for m in failed:
            if m["protectedReason"] != "load-on-startup":
                print(f"  Retry with: modelctl load {m['id']}")
        print("  The reason is in: journalctl -u llama-server")


def find(status, model_id):
    for m in status["models"]:
        if m["id"] == model_id:
            return m
    return None


def wait_for(model_id, want, timeout):
    """POST returns before the work is done, so poll GET /models or we lie."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        models = fetch_models()
        if models is not None:
            for m in models:
                if m["id"] == model_id:
                    if m["state"] == want:
                        return True, m["state"]
                    if m["state"] == "failed":
                        return False, "failed"
        time.sleep(1)
    current = find(build_status(), model_id)
    return False, current["state"] if current else "?"


def do_action(action, model_id, force):
    status = build_status()
    if not status["router"]["reachable"]:
        print("⚠ the router is not responding", file=sys.stderr)
        return 1

    model = find(status, model_id)
    if model is None:
        print(f"modelctl: '{model_id}' is not registered in the router. Models:", file=sys.stderr)
        for m in status["models"]:
            print("  " + m["id"], file=sys.stderr)
        return 1

    want = "loaded" if action == "load" else "unloaded"
    if model["state"] == want:
        print(f"  · {model_id} was already {want}")
        render(status)
        return 0

    if action == "unload" and model["protected"] and not force:
        print(f"⚠ '{model_id}' is protected ({model['protectedReason']}). "
              f"Repeat with --force if you really mean it.", file=sys.stderr)
        return 1

    if action == "load":
        router = status["router"]
        if router["modelsMax"] > 0 and router["loadedCount"] >= router["modelsMax"]:
            print(f"  ⚠ {router['loadedCount']} models are already loaded "
                  f"(--models-max {router['modelsMax']}): this load evicts another one")

    print(f"→ {'Loading' if action == 'load' else 'Unloading'} {model_id}")
    try:
        request_json(f"/models/{action}", payload={"model": model_id}, timeout=30)
    except (urllib.error.URLError, OSError, ValueError) as exc:
        print(f"  · {action} {model_id} ... FAILED (the router rejected the request: {exc})",
              file=sys.stderr)
        return 1

    timeout = LOAD_TIMEOUT if action == "load" else UNLOAD_TIMEOUT
    ok, state = wait_for(model_id, want, timeout)
    if ok:
        print(f"  · {action} {model_id} ... {want}")
    else:
        print(f"  ⚠ still '{state}' after {timeout}s "
              f"(check journalctl -u llama-server)", file=sys.stderr)

    print()
    render(build_status())
    return 0 if ok else 1


def cmd_restore(force):
    """Reload every load-on-startup model. The rescue after a failed boot."""
    status = build_status()
    if not status["router"]["reachable"]:
        print("⚠ the router is not responding", file=sys.stderr)
        return 1

    targets = [m for m in status["models"] if m["protectedReason"] == "load-on-startup"]
    if not targets:
        print("No models are marked load-on-startup")
        return 0

    rc = 0
    for m in targets:
        if m["state"] == "loaded":
            print(f"  · {m['id']} was already loaded")
            continue
        # One at a time: four concurrent loads is not something to ask of the router.
        if do_action("load", m["id"], force) != 0:
            rc = 1
    if rc:
        print("\n⚠ Something did not come back. Without it, agents get "
              "400 model is not loaded.", file=sys.stderr)
    return rc




# ---------------------------------------------------------------- watch
#
# GET /models/sse pushes the model lifecycle: loading with per-stage progress,
# loaded with metadata, unloaded with an exit code. Watching it beats polling
# on every axis that matters here: a failure shows up the moment it happens
# instead of up to one poll interval later, a minutes-long load gets a real
# progress bar, and nothing spawns a process every N seconds forever.
#
# Emits NDJSON: one complete snapshot per line, so the reader never has to
# merge partial state.

# The build emits "status_change"; the documented "model_status" arrives only
# as the first event of a stream. Accept both.
STATUS_EVENTS = ("status_change", "model_status")

# Progress arrives many times per second. Redrawing a bar faster than this
# buys nothing and costs a wakeup per event.
EMIT_INTERVAL = 0.2


def finalize(state):
    """Fold the live values (memory, counters) into the snapshot."""
    state["router"]["loadedCount"] = sum(
        1 for m in state["models"] if m["state"] == "loaded")
    used, total, pool = memory_mib()
    state["memory"] = {
        "pool": pool,
        "usedMiB": used,
        "totalMiB": total,
        "percent": round(used * 100 / total) if total else 0,
    }


def fingerprint(state):
    """Canonical form of what the widget renders, timestamps aside.

    Most SSE events carry no visible change; comparing this against the last
    emitted snapshot is what keeps identical lines from reaching QML, where
    every one of them re-evaluates bindings and repaints for nothing.
    """
    body = {k: v for k, v in state.items() if k != "updatedAt"}
    return json.dumps(body, sort_keys=True)


def emit(state):
    state["updatedAt"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    json.dump(state, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    sys.stdout.flush()


def unreachable_state():
    state = build_status()
    state["router"]["reachable"] = False
    state["models"] = []
    return state


def apply_event(state, evt):
    """Fold one SSE event into the snapshot. True when a full refresh is due."""
    model_id = evt.get("model")
    kind = evt.get("event")
    data = evt.get("data") or {}

    if kind in ("models_reload", "model_remove") or model_id == "*":
        return True

    row = next((m for m in state["models"] if m["id"] == model_id), None)
    if row is None:
        return True

    if kind not in STATUS_EVENTS:
        return False

    status = data.get("status")
    if status == "loading":
        row["state"] = "loading"
        progress = data.get("progress") or {}
        row["stage"] = progress.get("current")
        row["progress"] = progress.get("value")
        return False

    # loaded / unloaded / sleeping all settle the row, and a non-zero exit on
    # unload is the failure this widget exists to surface.
    row["progress"] = None
    row["stage"] = None
    if status == "unloaded" and data.get("exit_code"):
        row["state"] = "failed"
        row["exitCode"] = data.get("exit_code")
        return False
    row["state"] = status or row["state"]
    if status == "loaded":
        row["exitCode"] = None
    return status in ("loaded", "unloaded")


def stream_events(state, last_fp):
    """Follow the SSE stream, printing only snapshots that differ from last_fp.

    Returns the fingerprint of the last emitted snapshot, so a reconnect does
    not replay what the reader already has.
    """
    req = authorized_request(f"{ROUTER}/models/sse")
    req.add_header("Accept", "text/event-stream")
    last_emit = 0.0
    with OPENER.open(req) as resp:
        for raw in resp:
            line = raw.decode("utf-8", "replace").strip()
            if not line.startswith("data:"):
                continue
            try:
                evt = json.loads(line[5:].strip())
            except ValueError:
                continue
            needs_refresh = apply_event(state, evt)
            if needs_refresh:
                fresh = fetch_models()
                if fresh is not None:
                    state["models"] = fresh
                    state["router"]["modelsMax"] = models_max(find_router_proc() or [])
            finalize(state)
            fp = fingerprint(state)
            now = time.monotonic()
            if fp == last_fp:
                continue
            if not (needs_refresh or now - last_emit >= EMIT_INTERVAL):
                continue
            emit(state)
            last_emit = now
            last_fp = fp
    return last_fp


def cmd_watch():
    """Follow the router forever. Survives the router restarting under it."""
    last_fp = None
    while True:
        state = build_status()
        finalize(state)
        fp = fingerprint(state)
        if fp != last_fp:
            emit(state)
            last_fp = fp
        if state["router"]["reachable"]:
            try:
                last_fp = stream_events(state, last_fp)
            except (urllib.error.URLError, OSError, ValueError):
                pass
            # The stream ended: either the router went away or it restarted.
            state = unreachable_state()
            finalize(state)
            fp = fingerprint(state)
            if fp != last_fp:
                emit(state)
                last_fp = fp
        time.sleep(3)


def main():
    parser = argparse.ArgumentParser(
        prog="modelctl", description="Manage the local llama.cpp router (:8080)")
    parser.add_argument("--force", "-f", action="store_true",
                        help="bypass the protection on critical models")
    parser.add_argument("--router", metavar="URL",
                        help="router URL (default http://127.0.0.1:8080)")
    parser.add_argument("--api-key-file", metavar="PATH",
                        help="file holding API_KEY= or a bare key "
                             "(default ~/.config/llama-server.env)")
    sub = parser.add_subparsers(dest="command")

    p_status = sub.add_parser("status", help="router status")
    p_status.add_argument("--json", action="store_true", help="machine-readable output")

    p_load = sub.add_parser("load", help="load a model")
    p_load.add_argument("model")

    p_unload = sub.add_parser("unload", help="unload a model")
    p_unload.add_argument("model")

    sub.add_parser("restore", help="reload the load-on-startup set")
    sub.add_parser("watch", help="stream snapshots as NDJSON, driven by /models/sse")

    args = parser.parse_args()
    command = args.command or "status"

    # Globals, because every helper below reads them; argparse is the only
    # place that knows the user asked for a different router.
    global ROUTER, ENV_FILE
    if args.router:
        ROUTER = args.router.rstrip("/")
    if args.api_key_file:
        ENV_FILE = Path(args.api_key_file).expanduser()

    if command == "status":
        status = build_status()
        if getattr(args, "json", False):
            json.dump(status, sys.stdout, indent=2, ensure_ascii=False)
            print()
        else:
            render(status)
        return 0
    if command == "load":
        return do_action("load", args.model, args.force)
    if command == "unload":
        return do_action("unload", args.model, args.force)
    if command == "restore":
        return cmd_restore(args.force)
    if command == "watch":
        try:
            cmd_watch()
        except KeyboardInterrupt:
            pass
        return 0
    parser.print_help()
    return 1


if __name__ == "__main__":
    sys.exit(main())
